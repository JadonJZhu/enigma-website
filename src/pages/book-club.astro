---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fs from 'fs';
import path from 'path';

// Read and parse book club CSV data
const csvPath = path.resolve('./src/data/book-club.csv');
const csvContent = fs.readFileSync(csvPath, 'utf-8');
const booksData = csvContent.trim().split('\n').slice(1).map(line => {
  const values = line.split(',');
  return {
    name: values[0].replace(/"/g, '').trim(),
    author: values[1].replace(/"/g, '').trim(),
    quarter: values[2].replace(/"/g, '').trim()
  };
});

// Group books by quarter
const booksByQuarter: Record<string, typeof booksData> = booksData.reduce((acc, book) => {
  if (!acc[book.quarter]) {
    acc[book.quarter] = [];
  }
  acc[book.quarter].push(book);
  return acc;
}, {} as Record<string, typeof booksData>);

// Quarter order for consistent display
const quarterOrder = ['Winter', 'Spring', 'Summer', 'Fall'];

// Get available quarters sorted (most recent first)
const availableQuarters = Object.keys(booksByQuarter).sort((a, b) => {
  const [seasonA, yearA] = a.split(' ');
  const [seasonB, yearB] = b.split(' ');
  const yearDiff = parseInt(yearB) - parseInt(yearA);
  if (yearDiff !== 0) return yearDiff;
  return quarterOrder.indexOf(seasonB) - quarterOrder.indexOf(seasonA);
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Club - Enigma at UCLA</title>
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Raleway&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />

    <main class="main-content">
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="page-title">Book Club</h1>
        </div>
      </section>

      <!-- Books Section -->
      <section class="books-section">
        <div class="container">
          {availableQuarters.map(quarter => (
            <div class="quarter-section">
              <h3 class="quarter-title">{quarter}</h3>
              <div class="books-grid">
                {booksByQuarter[quarter].map(book => (
                  <div class="book-card">
                    <div class="book-info">
                      <h4 class="book-title">{book.name}</h4>
                      <p class="book-author">by {book.author}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Main Content Background */
  .main-content {
    min-height: 100vh;
    position: relative;
  }

  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--primary-color), #8E44AD);
    color: white;
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .page-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-family: 'Raleway', sans-serif;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Books Section */
  .books-section {
    background: white;
    padding: 4rem 0;
    position: relative;
  }


  .quarter-section {
    margin-bottom: 3rem;
  }

  .quarter-title {
    font-size: 1.8rem;
    color: var(--text-color);
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--primary-color);
    display: inline-block;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .book-card {
    background: var(--background-color);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: 2px solid transparent;
    background-image: linear-gradient(var(--background-color), var(--background-color)), var(--rainbow-gradient);
    background-origin: border-box;
    background-clip: padding-box, border-box;
    transition: all 0.3s ease;
  }

  .book-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .book-info {
    text-align: center;
  }

  .book-title {
    font-size: 1.3rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .book-author {
    font-size: 1rem;
    color: #666;
    font-style: italic;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .page-header {
      padding: 3rem 0 2rem;
    }

    .books-year {
      margin-bottom: 3rem;
      padding-bottom: 1.5rem;
    }

    .year-title {
      font-size: 2rem;
    }

    .quarter-title {
      font-size: 1.5rem;
    }

    .books-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .book-card {
      padding: 1.5rem;
    }

    .book-title {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .page-title {
      font-size: 2.5rem;
    }

    .quarter-title {
      font-size: 1.4rem;
    }

    .books-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .book-card {
      padding: 1.2rem;
    }

    .book-title {
      font-size: 1.1rem;
    }

    .book-author {
      font-size: 0.9rem;
    }
  }
</style>

