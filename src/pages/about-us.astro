---
import { Image, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Import officers data
import fs from 'fs';
import path from 'path';

// Import photos for gallery
import enigmatable from '../assets/photos/24-25/enigmatable.webp';
import someevent from '../assets/photos/24-25/someevent.webp';
import trivia from '../assets/photos/24-25/trivia.webp';
import picnic from '../assets/photos/24-25/picnic.webp';
import westmarchesfinal from '../assets/photos/24-25/westmarchesfinal.jpg';
import fridaynight from '../assets/photos/24-25/fridaynight.webp';
import morepicnic from '../assets/photos/24-25/morepicnic.webp';

const images = [
  { src: enigmatable, alt: 'Enigma members at their regular game table' },
  { src: someevent, alt: 'Enigma members at a special event' },
  { src: trivia, alt: 'Enigma trivia night' },
  { src: picnic, alt: 'Enigma picnic event' },
  { src: westmarchesfinal, alt: 'West Marches campaign final session' },
  { src: fridaynight, alt: 'Enigma Friday night gaming session' },
  { src: morepicnic, alt: 'Enigma members at another picnic event' },
];

const galleryImages = await Promise.all(
  images.map(async (image) => {
    const optimizedImage = await getImage({
      src: image.src,
      width: 2000,
      height: 1126,
    });
    return {
      alt: image.alt,
      src: optimizedImage.src,
      srcset: optimizedImage.attributes.srcset,
    };
  })
);

// Parse the whole CSV at once so quoted fields may contain commas, escaped quotes, and line breaks
function parseCSV(text: string) {
  const rows: string[][] = [];
  let row: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];

    if (inQuotes) {
      if (char === '"' && text[i + 1] === '"') {
        current += '"';
        i++;
      } else if (char === '"') {
        inQuotes = false;
      } else {
        current += char;
      }
    } else if (char === '"') {
      inQuotes = true;
    } else if (char === ',') {
      row.push(current.trim());
      current = '';
    } else if (char === '\n') {
      row.push(current.trim());
      rows.push(row);
      row = [];
      current = '';
    } else if (char !== '\r') {
      current += char;
    }
  }

  if (current || row.length) {
    row.push(current.trim());
    rows.push(row);
  }

  return rows;
}

const csvPath = path.resolve('./src/data/officers-master-list.csv');
const csvContent = fs.readFileSync(csvPath, 'utf-8');
const officerPhotos = import.meta.glob<ImageMetadata>('../assets/officers/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/*.JPG', { eager: true, import: 'default' });

const allOfficers = parseCSV(csvContent.trim()).slice(1).map(values => {
  const name = values[0];
  const term = values[5];
  const slug = name.toLowerCase().replace(/\s+/g, '');
  return {
    name,
    slug,
    position: values[1],
    year: values[2].charAt(0).toUpperCase() + values[2].slice(1),
    fieldOfStudy: values[3],
    biography: values[4],
    term,
    photo: officerPhotos[`../assets/officers/${term}/${slug}.JPG`] ?? null,
  };
});

// Newest term is the current board; everything else becomes history
const terms = [...new Set(allOfficers.map(officer => officer.term))].sort().reverse();
const currentTerm = terms[0];
const currentOfficers = allOfficers.filter(officer => officer.term === currentTerm);
const pastTerms = terms.slice(1).map(term => ({
  term,
  label: term.replace('-', '–'),
  groupPhoto: officerPhotos[`../assets/officers/${term}/group.JPG`] ?? null,
  officers: allOfficers.filter(officer => officer.term === term),
}));
const currentGroupPhoto = officerPhotos[`../assets/officers/${currentTerm}/group.JPG`];

// Bios are plain text; blank lines split paragraphs and ~~text~~ marks a strikethrough
function escapeHTML(text: string) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function bioToHTML(bio: string) {
  return bio
    .split(/\n\s*\n/)
    .map(paragraph => `<p>${escapeHTML(paragraph.trim()).replace(/~~(.+?)~~/g, '<s>$1</s>')}</p>`)
    .join('');
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us - Enigma at UCLA</title>
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Raleway&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />

    <main>
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="page-title">About Us</h1>
          <p class="page-subtitle">Meet the masterminds behind Enigma's adventures</p>
        </div>
      </section>

      <!-- Mission Section -->
      <section class="mission-section">
        <div class="container">
          <div class="mission-content">
            <h2 class="section-title">Our Mission</h2>
            <div class="mission-text">
              <p>
                From casual game nights to tournament-style competitions, from learning the basics of Dungeons
                & Dragons to exploring the streets of LA, Enigma provides a
                community for you to participate in a gaming and social experience while making lifelong friends along the way.
                We include everyone from undergrads to graduate students and alumni. If you're interested in board games, tabletop games, or anything nerdy (even just a bit), you're always welcome with us.
                There is no formal membership, so drop by any time! Students, staff, faculty, and local community members are all welcome!
              </p>
              <p>
                Our mission is to create an inclusive space where players of all experience levels can gather,
                learn, and grow together. We believe that the best games happen when diverse perspectives come
                together around the table, creating memorable experiences that extend far beyond the final score.
              </p>

            </div>
          </div>
        </div>
      </section>

      <!-- Officers Section -->
      <section class="officers-section" aria-labelledby="officers-title">
        <div class="container">
          <h2 class="section-title" id="officers-title">Meet the Officers</h2>
          <p class="officers-term">{currentTerm.replace('-', '–')} school year</p>

          <figure class="group-photo-figure">
            <Image
              src={currentGroupPhoto}
              alt={`The ${currentTerm.replace('-', '–')} Enigma officers on the steps of Powell Library`}
              class="group-photo"
              widths={[800, 1200, 1616]}
              sizes="(min-width: 1200px) 1136px, 100vw"
            />
          </figure>

          <p class="officers-hint">Select an officer to read their bio.</p>

          <ul class="officers-grid" role="list">
            {currentOfficers.map((officer) => (
              <li>
                <button class="officer" type="button" data-dialog={`officer-${officer.slug}`}>
                  <span class="officer-arch">
                    {officer.photo ? (
                      <Image
                        src={officer.photo}
                        alt=""
                        class="officer-photo"
                        widths={[300, 600]}
                        sizes="(min-width: 768px) 260px, 45vw"
                      />
                    ) : (
                      <span class="officer-photo officer-photo-empty" aria-hidden="true">{officer.name.charAt(0)}</span>
                    )}
                  </span>
                  <span class="officer-name">{officer.name}</span>
                  <span class="officer-position">{officer.position}</span>
                </button>

                <dialog class="officer-dialog" id={`officer-${officer.slug}`} aria-labelledby={`officer-${officer.slug}-name`}>
                  <form method="dialog" class="dialog-close-form">
                    <button class="dialog-close" aria-label={`Close ${officer.name}'s bio`}>×</button>
                  </form>
                  <div class="dialog-layout">
                    {officer.photo && (
                      <span class="dialog-arch">
                        <Image
                          src={officer.photo}
                          alt={`${officer.name}, ${officer.position}`}
                          class="officer-photo"
                          widths={[400, 800]}
                          sizes="(min-width: 768px) 300px, 60vw"
                        />
                      </span>
                    )}
                    <div class="dialog-text">
                      <h3 class="dialog-name" id={`officer-${officer.slug}-name`}>{officer.name}</h3>
                      <p class="dialog-position">{officer.position}</p>
                      <dl class="dialog-facts">
                        <div>
                          <dt>Year</dt>
                          <dd>{officer.year}</dd>
                        </div>
                        <div>
                          <dt>Studies</dt>
                          <dd>{officer.fieldOfStudy}</dd>
                        </div>
                      </dl>
                      <div class="dialog-bio" set:html={bioToHTML(officer.biography)} />
                    </div>
                  </div>
                </dialog>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Photos Section -->
      <section class="photos-section">
        <div class="container">
          <h2 class="section-title">Photos</h2>

          <!-- Gallery Section -->
          <div class="gallery-section">
            <!-- Filter Controls -->
            <div class="gallery-controls">
              <label for="campaign-select" class="filter-label">Year:</label>
              <select id="campaign-select" class="filter-dropdown">
                <option value="2024-2025">2024-2025</option>
              </select>
            </div>

            <!-- Main Gallery Display -->
            <div class="gallery-container">
              <!-- Main Image Display -->
              <div class="main-image-container">
                <div class="main-image-wrapper">
                  <Image
                    id="main-image"
                    src={images[0].src}
                    alt={images[0].alt}
                    class="main-image"
                    width={2000}
                    height={1126}
                    sizes="(min-width: 1000px) 1000px, 100vw"
                  />
                  <div class="image-overlay"></div>
                  <button class="nav-arrow prev-arrow" id="prev-btn" aria-label="Previous image">❮</button>
                  <button class="nav-arrow next-arrow" id="next-btn" aria-label="Next image">❯</button>
                </div>

              </div>

              <!-- Thumbnail Strip -->
              <div class="thumbnail-strip">
                <div class="thumbnail-container" id="thumbnail-container">
                  {images.map((image, index) => (
                    <Image
                      src={image.src}
                      alt={image.alt}
                      class:list={["thumbnail", { active: index === 0 }]}
                      width={120}
                      height={80}
                      data-index={index}
                    />
                  ))}
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Past Officers Section -->
      {pastTerms.length > 0 && (
        <section class="history-section" aria-labelledby="history-title">
          <div class="container">
            <h2 class="section-title" id="history-title">Past Officers</h2>
            <p class="history-intro">The people who kept Enigma running in years past.</p>

            <div class="history-terms">
              {pastTerms.map((past) => (
                <details class="term">
                  <summary class="term-summary">
                    <span class="term-year">{past.label}</span>
                    <span class="term-count">{past.officers.length} officers</span>
                    <span class="term-chevron" aria-hidden="true"></span>
                  </summary>

                  <div class="term-body">
                    {past.groupPhoto && (
                      <Image
                        src={past.groupPhoto}
                        alt={`The ${past.label} Enigma officers`}
                        class="term-group-photo"
                        widths={[600, 1000]}
                        sizes="(min-width: 1000px) 1000px, 100vw"
                        loading="lazy"
                      />
                    )}
                    <ul class="term-roster" role="list">
                      {past.officers.map((officer) => (
                        <li class="term-officer">
                          <span class="term-arch">
                            {officer.photo ? (
                              <Image
                                src={officer.photo}
                                alt=""
                                class="officer-photo"
                                widths={[160, 320]}
                                sizes="120px"
                                loading="lazy"
                              />
                            ) : (
                              <span class="officer-photo officer-photo-empty" aria-hidden="true">{officer.name.charAt(0)}</span>
                            )}
                          </span>
                          <span class="term-name">{officer.name}</span>
                          <span class="term-position">{officer.position}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--primary-color), #8E44AD);
    color: white;
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .page-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-family: 'Raleway', sans-serif;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Mission Section */
  .mission-section {
    background: white;
    padding: 4rem 0;
  }

  .section-title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: var(--text-color);
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }

  .section-title:after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--secondary-color);
    border-radius: 2px;
  }

  .mission-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .mission-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .mission-text p:first-child {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-color);
  }

  /* Officers Section
     Portraits are clipped to round-top arches that echo the Royce Hall
     arcade every headshot was taken in; the offset gold line is the archivolt. */
  .officers-section {
    --arch-gold: #D4A514;
    --plum: #4A2360;
    --lavender-wash: #F7F2FA;
    background: var(--lavender-wash);
    padding: 4rem 0 5rem;
  }

  .officers-term {
    text-align: center;
    font-size: 1.05rem;
    color: var(--plum);
    margin: 1.75rem 0 2.5rem;
  }

  .group-photo-figure {
    margin: 0 auto;
    max-width: 1136px;
  }

  .group-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 18px 40px -18px rgba(74, 35, 96, 0.45);
  }

  .officers-hint {
    text-align: center;
    color: var(--plum);
    font-size: 0.95rem;
    margin: 3.5rem 0 2.5rem;
  }

  /* Flex rather than grid so a short final row stays centered */
  .officers-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem 2rem;
    max-width: 1136px;
    margin: 0 auto;
  }

  .officers-grid > li {
    flex: 0 1 200px;
  }

  .officer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: center;
  }

  .officer-arch,
  .dialog-arch,
  .term-arch {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 10px 10px;
  }

  .officer-arch {
    max-width: 240px;
    margin-bottom: 1.25rem;
  }

  .officer-arch::before,
  .dialog-arch::before {
    content: '';
    position: absolute;
    inset: -7px;
    border: 2px solid var(--arch-gold);
    border-radius: inherit;
    transition: border-color 0.25s ease, inset 0.25s ease;
    pointer-events: none;
  }

  .officer-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    border-radius: inherit;
    background: #E9DDF0;
  }

  .officer-arch .officer-photo {
    transition: filter 0.25s ease;
  }

  .officer-photo-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    font-size: 2.5rem;
    color: var(--primary-color);
  }

  .officer:hover .officer-arch::before,
  .officer:focus-visible .officer-arch::before {
    border-color: var(--primary-color);
    inset: -11px;
  }

  .officer:hover .officer-arch .officer-photo {
    filter: saturate(1.15) brightness(1.04);
  }

  .officer:focus-visible {
    outline: none;
  }

  .officer:focus-visible .officer-name {
    text-decoration: underline;
    text-decoration-color: var(--primary-color);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .officer-name {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--text-color);
  }

  .officer-position {
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: var(--primary-color);
  }

  /* Officer bio dialog */
  .officer-dialog {
    margin: auto;
    width: min(760px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 2.5rem;
    border: none;
    border-radius: 18px;
    background: white;
    color: var(--text-color);
    box-shadow: 0 30px 60px -20px rgba(74, 35, 96, 0.5);
  }

  .officer-dialog::backdrop {
    background: rgba(45, 20, 60, 0.55);
    backdrop-filter: blur(3px);
  }

  .officer-dialog[open] {
    animation: dialog-in 0.22s ease-out;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .dialog-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .dialog-arch {
    margin: 7px;
    width: calc(100% - 14px);
  }

  .dialog-name {
    font-size: 1.9rem;
    margin-right: 2.5rem;
  }

  .dialog-position {
    color: var(--primary-color);
    font-size: 1.05rem;
    margin-top: 0.25rem;
  }

  .dialog-facts {
    display: grid;
    gap: 0.6rem;
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid #E6DCEC;
    border-bottom: 1px solid #E6DCEC;
  }

  .dialog-facts div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
  }

  .dialog-facts dt {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--plum);
  }

  .dialog-facts dd {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .dialog-bio :global(p) {
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 62ch;
  }

  .dialog-bio :global(p + p) {
    margin-top: 0.85rem;
  }

  /* Sticky so the close button stays reachable while a long bio scrolls */
  .dialog-close-form {
    position: sticky;
    top: 0;
    height: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
  }

  .dialog-close {
    margin: -1.25rem -1.25rem 0 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--lavender-wash);
    color: var(--plum);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    background: var(--primary-color);
    color: white;
  }

  .dialog-close:focus-visible {
    outline: 3px solid var(--secondary-color);
    outline-offset: 2px;
  }

  /* Past Officers Section */
  .history-section {
    background: white;
    padding: 4rem 0 5rem;
  }

  .history-intro {
    text-align: center;
    color: #555;
    margin: 1.75rem 0 2.5rem;
  }

  .history-terms {
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid #E6DCEC;
  }

  .term {
    border-bottom: 1px solid #E6DCEC;
  }

  .term-summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 0.5rem;
    cursor: pointer;
    list-style: none;
  }

  .term-summary::-webkit-details-marker {
    display: none;
  }

  .term-summary:focus-visible {
    outline: 3px solid var(--primary-color);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .term-year {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--text-color);
  }

  .term-count {
    color: #777;
    font-size: 0.95rem;
  }

  .term-chevron {
    margin-left: auto;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--primary-color);
    border-bottom: 2px solid var(--primary-color);
    transform: translateY(-4px) rotate(45deg);
    transition: transform 0.2s ease;
    align-self: center;
  }

  .term[open] .term-chevron {
    transform: translateY(2px) rotate(225deg);
  }

  .term-body {
    padding: 0.5rem 0.5rem 2.5rem;
  }

  .term-group-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }

  .term-roster {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 2rem 1.5rem;
  }

  .term-officer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .term-arch {
    max-width: 110px;
    margin-bottom: 0.75rem;
    box-shadow: 0 0 0 2px white, 0 0 0 3px #E0CFA0;
  }

  .term-name {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .term-position {
    font-size: 0.85rem;
    color: var(--primary-color);
  }

  @media (max-width: 768px) {
    .officers-grid {
      gap: 2.5rem 1.25rem;
    }

    .officers-grid > li {
      flex-basis: calc(50% - 0.625rem);
    }

    .officer-name {
      font-size: 1.05rem;
    }

    .officer-position {
      font-size: 0.85rem;
    }

    .officer-dialog {
      padding: 1.75rem 1.25rem;
    }

    .dialog-layout {
      grid-template-columns: 1fr;
