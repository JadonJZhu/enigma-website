---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Import officers data
import fs from 'fs';
import path from 'path';

const csvPath = path.resolve('./src/data/officers-master-list.csv');
const csvContent = fs.readFileSync(csvPath, 'utf-8');
const officersData = csvContent.trim().split('\n').slice(1).map(line => {
  const values = line.split(',');
  return {
    name: values[0],
    position: values[1],
    biography: values[2]
  };
});

// Function to get image filename for an officer
function getOfficerImageFilename(name: string) {
  return `/src/assets/officers/${name.toLowerCase().replace(/\s+/g, '')}.JPG`;
}

// Function to check if image exists (client-side check)
function getOfficerImage(name: string) {
  const filename = getOfficerImageFilename(name);
  // We'll handle missing images with CSS/JS on the client side
  return filename;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us - Enigma at UCLA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Raleway&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />

    <main>
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="page-title">About Us</h1>
          <p class="page-subtitle">Meet the masterminds behind Enigma's adventures</p>
        </div>
      </section>

      <!-- Mission Section -->
      <section class="mission-section">
        <div class="container">
          <div class="mission-content">
            <h2 class="section-title">Our Mission</h2>
            <div class="mission-text">
              <p>
                From casual game nights to tournament-style competitions, from learning the basics of Dungeons
                & Dragons to exploring the streets of LA, Enigma provides the platform and
                community for you to level up your gaming and social experience while making lifelong friends along the way.
                We include everyone from undergrads to graduate students and alumni. If you're interested in board games, tabletop games, or anything nerdy (even just a bit), you're always welcome with us.
                There is no formal membership, so drop by any time! Students, staff, faculty, and local community members are all welcome!
              </p>
              <p>
                Our mission is to create an inclusive space where players of all experience levels can gather,
                learn, and grow together. We believe that the best games happen when diverse perspectives come
                together around the table, creating memorable experiences that extend far beyond the final score.
              </p>

            </div>
          </div>
        </div>
      </section>

      <!-- Officers Section -->
      <section class="officers-section">
        <div class="container">
          <h2 class="section-title">Meet the Officers</h2>

          <!-- Group Photo -->
          <div class="group-photo-container">
            <img
              src="/src/assets/officers/officers.JPG"
              alt="Enigma officers group photo"
              class="group-photo"
            />
          </div>

          <div class="officers-grid">
            {officersData.map((officer) => (
              <div class="officer-card">
                <div class="officer-avatar">
                  <div class={`avatar-container ${officer.name.toLowerCase().replace(/\s+/g, '')}`}>
                    <img
                      src={getOfficerImage(officer.name)}
                      alt={`${officer.name} profile photo`}
                      class="officer-image"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="avatar-placeholder" style="display: none;">
                      <span class="avatar-emoji">👤</span>
                    </div>
                  </div>
                </div>
                <div class="officer-info">
                  <h3 class="officer-name">{officer.name}</h3>
                  <h4 class="officer-title">{officer.position}</h4>
                  <p class="officer-bio">
                    {officer.biography}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--primary-color), #8E44AD);
    color: white;
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .page-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-family: 'Raleway', sans-serif;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Mission Section */
  .mission-section {
    background: white;
    padding: 4rem 0;
  }

  .section-title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: var(--text-color);
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }

  .section-title:after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--secondary-color);
    border-radius: 2px;
  }

  .mission-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .mission-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .mission-text p:first-child {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-color);
  }

  /* Officers Section */
  .officers-section {
    background: var(--background-color);
    padding: 4rem 0;
  }

  .group-photo-container {
    text-align: center;
    margin-bottom: 3rem;
  }

  .group-photo {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    border: 2px solid transparent;
    background-image: linear-gradient(white, white), var(--rainbow-gradient);
    background-origin: border-box;
    background-clip: padding-box, border-box;
  }

  .officers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .officer-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border: 2px solid transparent;
    background-image: linear-gradient(white, white), var(--rainbow-gradient);
    background-origin: border-box;
    background-clip: padding-box, border-box;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .officer-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(155, 89, 182, 0.05), rgba(241, 196, 15, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .officer-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
  }

  .officer-card:hover::before {
    opacity: 1;
  }

  .officer-avatar {
    margin-bottom: 1.5rem;
  }

  .avatar-container {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(155, 89, 182, 0.3);
  }

  .officer-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(155, 89, 182, 0.3);
  }

  .avatar-emoji {
    font-size: 3rem;
    line-height: 1;
  }

  .officer-name {
    font-size: 1.5rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .officer-title {
    font-size: 1rem;
    color: var(--primary-color);
    margin-bottom: 1rem;
    font-weight: 600;
    font-style: italic;
  }

  .officer-bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .group-photo-container {
      margin-bottom: 2rem;
    }

    .group-photo {
      border-radius: 12px;
    }

    .officers-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .mission-text p {
      text-align: left;
    }

    .avatar-container {
      width: 100px;
      height: 100px;
    }

    .avatar-placeholder {
      width: 100%;
      height: 100%;
    }

    .avatar-emoji {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .group-photo-container {
      margin-bottom: 1.5rem;
    }

    .page-header {
      padding: 3rem 0 2rem;
    }

    .mission-section,
    .officers-section {
      padding: 3rem 0;
    }

    .officer-card {
      padding: 1.5rem;
    }

    .officer-name {
      font-size: 1.3rem;
    }

    .section-title {
      font-size: 2rem;
    }
  }
</style>
