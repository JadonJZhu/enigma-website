</style>

<script define:vars={{ galleryImages }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mainImageWrapper = document.querySelector('.main-image-wrapper');
    const thumbnails = document.querySelectorAll('.thumbnail');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    let currentIndex = 0;

    function updateMainImage(index) {
      const newImage = galleryImages[index];

      // Find the existing image element and update it instead of recreating everything
      const existingImg = mainImageWrapper.querySelector('#main-image');
      if (existingImg) {
        existingImg.src = newImage.src;
        existingImg.alt = newImage.alt;
        if (newImage.srcset) {
          existingImg.srcset = newImage.srcset;
        }
      }

      // Update active thumbnail
      thumbnails.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });

      currentIndex = index;
    }

    // Thumbnail click handlers
    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => {
        updateMainImage(index);
      });
    });

    // Navigation button handlers
    prevBtn.addEventListener('click', () => {
      const newIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      updateMainImage(newIndex);
    });

    nextBtn.addEventListener('click', () => {
      const newIndex = (currentIndex + 1) % galleryImages.length;
      updateMainImage(newIndex);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (document.querySelector('.officer-dialog[open]')) return;
      if (e.key === 'ArrowLeft') {
        const newIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
        updateMainImage(newIndex);
      } else if (e.key === 'ArrowRight') {
        const newIndex = (currentIndex + 1) % galleryImages.length;
        updateMainImage(newIndex);
      }
    });

    // Officer bio dialogs
    document.querySelectorAll('.officer').forEach(button => {
      const dialog = document.getElementById(button.dataset.dialog);
      button.addEventListener('click', () => dialog.showModal());

      // Clicking the backdrop closes it; require press and release both outside
      // the box so dragging a text selection out of the bio doesn't close it
      const isOutside = (e) => {
        const rect = dialog.getBoundingClientRect();
        return e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom;
      };
      let pressedOutside = false;
      dialog.addEventListener('pointerdown', (e) => {
        pressedOutside = e.target === dialog && isOutside(e);
      });
      dialog.addEventListener('click', (e) => {
        if (pressedOutside && e.target === dialog && isOutside(e)) dialog.close();
        pressedOutside = false;
      });
    });
  });
</script>
