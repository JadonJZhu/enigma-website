---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEventsByQuarterStatic, type EventData } from '../data/events';

// Load events data
const eventsByQuarter = getEventsByQuarterStatic();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Events - Enigma at UCLA</title>
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Raleway&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />

    <main>
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="page-title">Events</h1>
          <p class="page-subtitle">Join our <a href="https://discord.gg/yeayd5nS7x" target="_blank" class="discord-link">Discord</a> for the most up-to-date information!</p>
        </div>
      </section>

      <!-- Upcoming Event Section -->
      <section class="upcoming-event-section">
        <div class="container">
          <div class="upcoming-events-container">
            <div id="upcoming-event" class="upcoming-event-card">
              <!-- Upcoming event will be populated by JavaScript -->
            </div>
            <div id="friday-game-night" class="upcoming-event-card">
              <!-- Friday Game Night will be populated by JavaScript -->
            </div>
          </div>
        </div>
      </section>

      <!-- See All Events Header -->
      <section class="see-all-events-header">
        <div class="container">
          <h2 class="see-all-events-title">See All Events</h2>
          <p class="see-all-events-subtitle">Browse through our events by quarter</p>
        </div>
      </section>

      <!-- Filter Section -->
      <section class="filter-section">
        <div class="container">
          <div class="filter-controls">
            <label for="quarter-select" class="filter-label">Select Quarter:</label>
            <select id="quarter-select" class="filter-dropdown">
              <!-- Options will be populated by JavaScript -->
            </select>
          </div>
        </div>
      </section>

      <!-- Events List -->
      <section class="events-section">
        <div class="container">
          <div id="events-list" class="events-list">
            <!-- Events will be populated by JavaScript -->
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <template id="event-item-template">
      <div class="event-item">
        <div class="event-date">
          <span class="date"></span>
          <span class="month"></span>
          <span class="year"></span>
        </div>
        <div class="event-content">
          <h3 class="event-title"></h3>
          <div class="event-details">
            <span class="time">🕐 8:00 PM</span>
            <span class="location">📍 Virtual Event</span>
          </div>
          <p class="event-description"></p>
        </div>
      </div>
    </template>

    <script define:vars={{ eventsByQuarter }}>
      // Event data
      const eventData = eventsByQuarter;

      // Helper function to slugify text
      function slugify(text) {
        return text.toLowerCase().replace(/\s+/g, '-');
      }

      // Function to format date for display
      function formatEventDate(dateStr) {
        try {
          const date = new Date(dateStr);
          if (isNaN(date.getTime())) {
            // Fallback for dates that might not be parsed correctly, though should be rare.
            const [datePart] = dateStr.split(' ');
            const [month, day, year] = datePart.split('/');
            return {
              date: day || '??',
              month: new Date(2000, parseInt(month, 10) - 1, 1).toLocaleDateString('en-US', { month: 'short' }),
              year: year || '????',
            };
          }

          return {
            date: date.getDate().toString(),
            month: date.toLocaleDateString('en-US', { month: 'short' }),
            year: date.getFullYear().toString(),
          };
        } catch (error) {
          console.error(`Error formatting date: ${dateStr}`, error);
          return { date: '??', month: '???', year: '????' };
        }
      }

      // Function to parse date strings like "6/24/2025 8:00PM"
      function parseEventDate(dateStr) {
        try {
          // First try standard parsing
          const date = new Date(dateStr);
          if (!isNaN(date.getTime())) {
            return date;
          }

          // Fallback: parse MM/DD/YYYY HH:MMAM/PM format
          const [datePart, timePart] = dateStr.split(' ');
          if (!datePart || !timePart) return null;

          const [month, day, year] = datePart.split('/');
          if (!month || !day || !year) return null;

          // Parse time (e.g., "8:00PM")
          const timeMatch = timePart.match(/(\d+):(\d+)(AM|PM)/i);
          if (!timeMatch) return null;

          let hours = parseInt(timeMatch[1], 10);
          const minutes = parseInt(timeMatch[2], 10);
          const period = timeMatch[3].toUpperCase();

          // Convert to 24-hour format
          if (period === 'PM' && hours !== 12) {
            hours += 12;
          } else if (period === 'AM' && hours === 12) {
            hours = 0;
          }

          return new Date(
            parseInt(year, 10),
            parseInt(month, 10) - 1, // months are 0-indexed
            parseInt(day, 10),
            hours,
            minutes
          );
        } catch (error) {
          console.error('Error parsing date:', dateStr, error);
          return null;
        }
      }


      // Function to find the next upcoming event
      function findNextUpcomingEvent() {
        const now = new Date();
        let nextEvent = null;
        let nextEventDate = null;

        // Flatten all events from all quarters
        Object.values(eventData).forEach(quarterEvents => {
          quarterEvents.forEach(event => {
            if (event.startTime) {
              const eventDate = parseEventDate(event.startTime);
              if (eventDate && eventDate > now && (!nextEventDate || eventDate < nextEventDate)) {
                nextEvent = event;
                nextEventDate = eventDate;
              }
            }
          });
        });

        return nextEvent;
      }

      // Function to render upcoming event
      function renderUpcomingEvent() {
        const upcomingEvent = findNextUpcomingEvent();
        const upcomingEventContainer = document.getElementById('upcoming-event');

        if (upcomingEvent) {
          const formattedDate = formatEventDate(upcomingEvent.startTime);
          const startTime = formatTime(upcomingEvent.startTime);
          const endTime = formatTime(upcomingEvent.endTime);
          const startDate = parseEventDate(upcomingEvent.startTime);
          const endDate = parseEventDate(upcomingEvent.endTime);
          const location = upcomingEvent.location.trim() || 'To be decided';
          const baseDescription = upcomingEvent.description.trim() || '';
          const description = baseDescription;

          const timeDisplay = (startTime === endTime || (startDate && endDate && endDate <= startDate)) ? startTime : `${startTime} - ${endTime}`;

          upcomingEventContainer.innerHTML = `
            <div class="upcoming-badge">UPCOMING EVENT</div>
            <div class="upcoming-content">
              <div class="upcoming-date">
                <span class="upcoming-date-day">${formattedDate.date}</span>
                <span class="upcoming-date-month">${formattedDate.month}</span>
                <span class="upcoming-date-year">${formattedDate.year}</span>
              </div>
              <div class="upcoming-details">
                <h2 class="upcoming-title">${upcomingEvent.name}</h2>
                <div class="upcoming-meta">
                  <span class="upcoming-time">🕐 ${timeDisplay}</span>
                  <span class="upcoming-location">📍 ${location}</span>
                </div>
                <p class="upcoming-description">${description}</p>
              </div>
            </div>
          `;
        } else {
          upcomingEventContainer.innerHTML = `
            <div class="no-upcoming">
              <p>No upcoming events scheduled. Check back soon!</p>
            </div>
          `;
        }
      }

      // Function to render Friday Game Night
      function renderFridayGameNight() {
        const fridayGameNightContainer = document.getElementById('friday-game-night');
        const baseDescription = "Join us for a casual Friday night of gaming! Play with Enigma's extensive board game collection or bring your own games. All skill levels welcome in this relaxed, social atmosphere.";
        const description = baseDescription;

        fridayGameNightContainer.innerHTML = `
          <div class="upcoming-badge">REGULAR EVENT</div>
          <div class="upcoming-content">
            <div class="upcoming-details">
              <h2 class="upcoming-title">Friday Game Night</h2>
              <div class="upcoming-meta">
                <span class="upcoming-time">🕐 8:00 PM</span>
                <span class="upcoming-location">📍 Saxon Suites</span>
              </div>
              <p class="upcoming-description">${description}</p>
            </div>
          </div>
        `;
      }

      // Helper function to format time (extracted from renderEvents)
      function formatTime(timeStr) {
        try {
          // Check if time is empty, null, undefined, or just whitespace
          if (!timeStr || timeStr.trim() === '') {
            return 'TBD';
          }

          const date = new Date(timeStr);
          if (!isNaN(date.getTime())) {
            const formattedTime = date.toLocaleTimeString('en-US', {
              hour: 'numeric',
              minute: '2-digit',
              hour12: true
            });
            // Check if the time is 12:00 AM
            if (formattedTime === '12:00 AM') {
              return 'TBD';
            }
            return formattedTime;
          }

          // Fallback for parsing time part
          const timeMatch = timeStr.match(/(\d{1,2}:\d{2}[AP]M)/i);
          if (timeMatch) {
            // Check if the matched time is 12:00 AM
            if (timeMatch[1].toLowerCase() === '12:00am') {
              return 'TBD';
            }
            return timeMatch[1];
          }

          return 'TBD';
        } catch (error) {
          return 'TBD';
        }
      }

      // Function to render events
      function renderEvents(events, quarter) {
        const eventsList = document.getElementById('events-list');
        const template = document.getElementById('event-item-template');
        eventsList.innerHTML = ''; // Clear previous events

        if (events && events.length > 0) {
          // Create quarter header
          const quarterTitle = document.createElement('h2');
          quarterTitle.className = 'quarter-title';
          quarterTitle.textContent = getQuarterDisplayName(quarter);
          eventsList.appendChild(quarterTitle);

          // Create container for all events in the quarter
          const eventsContainer = document.createElement('div');
          eventsContainer.className = 'events-container';

          // Group events by week
          const eventsByWeek = events.reduce((acc, event) => {
            const weekKey = event.week ? `Week ${event.week}` : 'General';
            if (!acc[weekKey]) {
              acc[weekKey] = [];
            }
            acc[weekKey].push(event);
            return acc;
          }, {});

          // Sort weeks: 'General' first, then numerically by week number
          const sortedWeeks = Object.keys(eventsByWeek).sort((a, b) => {
            if (a === 'General') return -1;
            if (b === 'General') return 1;
            const weekA = parseInt(a.replace('Week ', ''), 10);
            const weekB = parseInt(b.replace('Week ', ''), 10);
            return weekA - weekB;
          });

          // Render events for each week
          sortedWeeks.forEach(week => {
            if (week !== 'General') {
              const weekTitle = document.createElement('h3');
              weekTitle.className = 'week-title';
              weekTitle.textContent = week;
              eventsContainer.appendChild(weekTitle);
            }

            const weekEvents = eventsByWeek[week].sort((a, b) => new Date(a.startTime) - new Date(b.startTime));

            weekEvents.forEach(event => {
              const formattedDate = formatEventDate(event.startTime);
              const eventItem = template.content.cloneNode(true);

              // Add special class for gold effect if event is marked as special
              if (event.special === 'TRUE') {
                eventItem.querySelector('.event-item').classList.add('special-event');
              }

              eventItem.querySelector('.date').textContent = formattedDate.date;
              eventItem.querySelector('.month').textContent = formattedDate.month;
              eventItem.querySelector('.year').textContent = formattedDate.year;
              eventItem.querySelector('.event-title').textContent = event.name;

              const startTime = formatTime(event.startTime);
              const endTime = formatTime(event.endTime);
              const startDate = parseEventDate(event.startTime);
              const endDate = parseEventDate(event.endTime);
              const timeDisplay = (startTime === endTime || (startDate && endDate && endDate <= startDate)) ? startTime : `${startTime} - ${endTime}`;
              eventItem.querySelector('.time').textContent = `🕐 ${timeDisplay}`;

              // Use actual location or default to "To be decided"
              const location = event.location.trim() || 'To be decided';
              eventItem.querySelector('.location').textContent = `📍 ${location}`;

              // Use actual description or empty string
              const baseDescription = event.description.trim() || '';
              const description = baseDescription;
              eventItem.querySelector('.event-description').innerHTML = description;

              // Add class for events without description to reduce height
              if (!description) {
                eventItem.querySelector('.event-item').classList.add('no-description');
              }

              eventsContainer.appendChild(eventItem);
            });
          });

          eventsList.appendChild(eventsContainer);
        } else {
          let message = `<p>No events scheduled for this quarter yet. Check back soon!</p>`;
          if (quarter === 'winter-2026' || quarter === 'spring-2026') {
             message = `<p>Events for this quarter have not been decided yet. Join our <a href="https://discord.gg/yeayd5nS7x" target="_blank" class="discord-link">Discord server</a> to get notified when events are announced.</p>`;
          }
          eventsList.innerHTML = `
            <div class="no-events">
              ${message}
            </div>
          `;
        }
      }

      // Helper function to get display name for quarter
      function getQuarterDisplayName(quarter) {
        if (!quarter) return '';
        const parts = quarter.split('-');
        if (parts.length !== 2) return quarter;
        const season = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
        const year = parts[1];
        return `${season} ${year}`;
      }

      // Handle quarter selection change
      function handleQuarterChange() {
        const quarterSelect = document.getElementById('quarter-select');
        const selectedQuarter = quarterSelect.value;
        const events = eventData[selectedQuarter] || [];
        renderEvents(events, selectedQuarter);
      }

      // Initialize page
      document.addEventListener('DOMContentLoaded', function() {
        const quarterSelect = document.getElementById('quarter-select');
        const availableQuarters = Object.keys(eventData);

        function sortQuarters(quarters) {
          const seasonOrder = { 'winter': 1, 'spring': 2, 'summer': 3, 'fall': 4 };
          return quarters.sort((a, b) => {
            const [aSeason, aYear] = a.split('-');
            const [bSeason, bYear] = b.split('-');
            if (aYear !== bYear) {
              return aYear - bYear;
            }
            return seasonOrder[aSeason] - seasonOrder[bSeason];
          });
        }

        const sortedQuarters = sortQuarters(availableQuarters);

        sortedQuarters.forEach(quarterSlug => {
          const option = document.createElement('option');
          option.value = quarterSlug;
          option.textContent = getQuarterDisplayName(quarterSlug);
          quarterSelect.appendChild(option);
        });

        // Find the quarter of the next upcoming event
        const nextEvent = findNextUpcomingEvent();
        let selectedQuarter;
        if (nextEvent) {
          selectedQuarter = slugify(nextEvent.quarter);
        } else if (sortedQuarters.length > 0) {
          selectedQuarter = sortedQuarters[sortedQuarters.length - 1];
        }

        if (selectedQuarter) {
            quarterSelect.value = selectedQuarter;
        }

        quarterSelect.addEventListener('change', handleQuarterChange);

        // Load initial events and upcoming event
        handleQuarterChange();
        renderUpcomingEvent();
        renderFridayGameNight();
      });
    </script>
  </body>
</html>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--primary-color), #8E44AD);
    color: white;
    padding: 4rem 0 3rem;
    text-align: center;
  }

  /* Upcoming Event Section */
  .upcoming-event-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 3rem 0;
    position: relative;
    overflow: hidden;
  }

  .upcoming-event-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="80" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
    opacity: 0.3;
    pointer-events: none;
  }

  .upcoming-events-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .upcoming-event-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
    z-index: 1;
  }

  .upcoming-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 25px;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 15px rgba(241, 196, 15, 0.3);
  }

  .upcoming-content {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .upcoming-date {
    background: var(--primary-color);
    color: white;
    padding: 1.5rem 1rem;
    border-radius: 15px;
    text-align: center;
    min-width: 100px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: 'Poppins', sans-serif;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .upcoming-date-day {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .upcoming-date-month {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .upcoming-date-year {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .upcoming-details {
    flex: 1;
  }

  .upcoming-title {
    font-size: 2rem;
    color: var(--text-color);
    margin-bottom: 1rem;
    line-height: 1.2;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
  }

  .upcoming-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    color: #666;
  }

  .upcoming-time,
  .upcoming-location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .upcoming-description {
    color: #555;
    line-height: 1.6;
    font-size: 1.1rem;
    font-family: 'Raleway', sans-serif;
  }

  .no-upcoming {
    text-align: center;
    padding: 2rem;
  }

  .no-upcoming p {
    color: #666;
    font-size: 1.1rem;
    font-family: 'Raleway', sans-serif;
    margin: 0;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .page-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-family: 'Raleway', sans-serif;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  /* See All Events Header */
  .see-all-events-header {
    background: white;
    padding: 3rem 0 2rem;
    text-align: center;
    border-bottom: 1px solid #e0e0e0;
  }

  .see-all-events-title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: var(--text-color);
    margin-bottom: 1rem;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
  }

  .see-all-events-subtitle {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: #666;
    font-family: 'Raleway', sans-serif;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Filter Section */
  .filter-section {
    background: white;
    padding: 2rem 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .filter-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: var(--text-color);
    font-size: 1rem;
  }

  .filter-dropdown {
    padding: 0.5rem 1rem;
    border: 2px solid var(--primary-color);
    border-radius: 6px;
    background: white;
    font-family: 'Raleway', sans-serif;
    font-size: 1rem;
    color: var(--text-color);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-dropdown:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.2);
  }

  /* Events Section */
  .events-section {
    padding: 3rem 0;
    background: var(--background-color);
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .quarter-title {
    font-size: 2rem;
    color: var(--text-color);
    text-align: center;
    margin-bottom: 2rem;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
  }

  .events-container {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }

  .week-title {
    font-size: 1.5rem;
    color: var(--text-color);
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e0e0e0;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
  }

  .events-container > .week-title:first-child {
    margin-top: 0;
  }

  .event-item {
    display: flex;
    background: white;
    border-radius: 12px;
    border-left: 4px solid var(--primary-color);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: all 0.3s ease;
    margin-bottom: 1.5rem;
  }

  .event-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .event-item.special-event {
    border-left-color: #ffd90082;
    box-shadow: 0 4px 6px rgba(255, 215, 0, 0.2);
    position: relative;
  }

  .event-item.special-event:hover {
    box-shadow: 0 8px 25px rgba(255, 215, 0, 0.3);
    border-left-color: #FFA500;
  }

  .event-item.no-description .event-content {
    padding: 1.5rem;
  }

  .event-item.no-description .event-date {
    padding: 1.5rem 1rem;
  }

  .event-item.no-description .event-title {
    font-size: 2rem;
  }

  .event-item.no-description .event-details {
    font-size: 1.1rem;
  }

  .event-item.special-event .event-date {
    background: linear-gradient(135deg, #FFD700, #FFA500);
    position: relative;
  }

  .event-item.special-event .event-date::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent);
    pointer-events: none;
  }

  .event-date {
    background: var(--primary-color);
    color: white;
    padding: 2rem 1rem;
    text-align: center;
    min-width: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    gap: 0.25rem;
  }

