            <span class="social-text">Instagram</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="footer-bottom">
      <div class="footer-container">
        <p class="copyright">© 2025 Enigma at UCLA. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: white;
    margin-top: auto;
    position: relative;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3rem;
    padding: 3rem 0 2rem 0;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    margin-bottom: 1rem;
  }

  .logo-placeholder {
    width: 120px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .logo-text {
    color: white;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .footer-heading {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    color: white;
    margin: 0 0 1.5rem 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.75rem;
  }

  .footer-link {
    color: white;
    text-decoration: none;
    font-family: 'Raleway', sans-serif;
    transition: color 0.3s ease;
    font-size: 1rem;
  }

  .footer-link:hover {
    color: var(--secondary-color);
  }

  .social-icons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem;
    border-radius: 4px;
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--secondary-color);
    transform: translateX(5px);
  }

  .discord-link {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 0.5rem;
  }

  .social-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .discord-icon {
    width: 28px;
    height: 28px;
  }

  .social-text {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.1);
  }

  .copyright {
    text-align: center;
    color: white;
    font-family: 'Raleway', sans-serif;
    font-size: 0.9rem;
    margin: 0;
    padding: 1.5rem 0;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 0 1.5rem 0;
    }

    .footer-container {
      padding: 0 1rem;
    }

    .footer-logo {
      margin-bottom: 0.75rem;
    }

    .logo-placeholder {
      width: 100px;
      height: 35px;
    }

    .logo-text {
      font-size: 1rem;
    }

    .footer-tagline {
      font-size: 1rem;
    }

    .footer-heading {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .footer-content {
      gap: 1.5rem;
      padding: 1.5rem 0 1rem 0;
    }

    .social-link {
      padding: 0.4rem;
    }

    .social-text {
      font-size: 0.9rem;
    }

    .copyright {
      font-size: 0.85rem;
      padding: 1rem 0;
    }
  }
</style>
