---
// Footer component for Enigma website
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Column 1: Logo and Tagline -->
      <div class="footer-column">
        <div class="footer-logo">
          <div class="logo-placeholder">
            <span class="logo-text">ENIGMA</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-column">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/" class="footer-link">Home</a></li>
          <li><a href="/game-nights" class="footer-link">Game Nights</a></li>
          <li><a href="/the-guild" class="footer-link">The Guild</a></li>
          <li><a href="/lore-legends" class="footer-link">Lore & Legends</a></li>
          <li><a href="/faq" class="footer-link">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: Social Media -->
      <div class="footer-column">
        <h3 class="footer-heading">Join Our Quest</h3>
